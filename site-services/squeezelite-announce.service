[Unit]
Description=Squeezelite Announce player (overlay announcements + alarm, mixed on ch0)
After=network.target logitechmediaserver.service

[Service]
Type=simple
# Force ONE clean soxr resample to the DAC's 48kHz. CRITICAL: recipe is -R hLX, NOT hLE.
# The 'E' (exception) flag = "resample ONLY IF native rate not supported" — on the ch0boost
# PLUG (accepts any rate) squeezelite intermittently judged the 44.1kHz TTS "supported",
# SKIPPED its own resample, and dumped raw 44.1kHz mono onto the ALSA plug -> plug's
# mono+resample chopped it ("helicopter", intermittent). 'X' (async) ALWAYS resamples to
# the device rate (48000, pinned by -r 48000) — unconditional + reliable. (2026-07-15)
ExecStart=/usr/bin/squeezelite -n Announce -o ch0boost -m 0d:b3:77:92:1f:4d -s 127.0.0.1 -a 300:8:: -p 45 -r 48000 -R hLX
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
